{
  "manifest_version": 3,
  "name": "Blister",
  "version": "0.1.0",
  "description": "Send downloads, links and videos to the Blister download manager.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Blister" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["downloads", "contextMenus", "storage", "cookies", "notifications"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "110"
}
